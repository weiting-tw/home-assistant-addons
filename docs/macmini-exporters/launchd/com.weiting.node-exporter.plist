<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.weiting.node-exporter</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node_exporter</string>
    <string>--web.listen-address=0.0.0.0:9100</string>
    <string>--collector.disable-defaults</string>
    <string>--collector.cpu</string>
    <string>--collector.loadavg</string>
    <string>--collector.meminfo</string>
    <string>--collector.filesystem</string>
    <string>--collector.netdev</string>
    <string>--collector.diskstats</string>
    <string>--collector.thermal</string>
    <!-- macmon 寫入的 Apple Silicon 溫度與功耗；node_exporter 自己讀不到。 -->
    <string>--collector.textfile</string>
    <string>--collector.textfile.directory=/Users/weiting/.node_exporter/textfile</string>
    <string>--collector.uname</string>
    <string>--collector.time</string>
    <string>--collector.boottime</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/weiting/Library/Logs/node_exporter.log</string>
  <key>StandardErrorPath</key><string>/Users/weiting/Library/Logs/node_exporter.log</string>
</dict>
</plist>
